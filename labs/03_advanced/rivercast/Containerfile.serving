# rivercast-serving: forecast, deploy (smoke test), and the future FastAPI
# application (PLAN.md Phase 8 now; Phase 11 adds src/rivercast/serving/).
# Immutable tag convention: rivercast-serving:<git-sha>, built in CI or an
# approved cluster build service, never inside the JupyterLab workbench
# (CLAUDE.md rules 19-20).
FROM registry.access.redhat.com/ubi9/python-311:latest

WORKDIR /app

COPY pyproject.toml ./
COPY src/ ./src/
COPY components/ ./components/

RUN pip install --no-cache-dir .

COPY configs/ ./configs/

EXPOSE 8080

USER 1001

ENTRYPOINT ["python", "-m"]
CMD ["components.forecast.component", "--help"]
